# ── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-here
DEBUG=False
ALLOWED_HOSTS=www.yourplatform.com,yourplatform.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=clarity_website
DB_USER=website_user
DB_PASSWORD=your-db-password-here
DB_HOST=db
DB_PORT=5432

# ── Docker / Registry ────────────────────────────────────────────────────────
DOCKER_REGISTRY=tinashemp
TAG=latest

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Caching ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Contact Form ─────────────────────────────────────────────────────────────
CONTACT_FORM_RECIPIENT=info@yourplatform.com

# ── Analytics & SEO ──────────────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=

# ── reCAPTCHA ────────────────────────────────────────────────────────────────
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
