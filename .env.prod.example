# Production Environment Configuration — Avail Technologies Website
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-prod
DEBUG=False
ALLOWED_HOSTS=availtechnologies.co.zw,www.availtechnologies.co.zw,127.0.0.1,localhost,your-aws-ec2-ip
CSRF_TRUSTED_ORIGINS=https://availtechnologies.co.zw,https://www.availtechnologies.co.zw,http://localhost

# Port exposed on AWS Host (default 80 for direct public HTTP traffic)
HOST_PORT=80

# PostgreSQL Database Configuration
DB_NAME=clarity_website
DB_USER=website_user
DB_PASSWORD=generate-a-strong-secure-db-password-here
DB_HOST=db
DB_PORT=5432

# (Optional SQLite override instead of PostgreSQL container)
# DB_ENGINE=sqlite3
# SQLITE_PATH=/app/data/db.sqlite3

# Docker Hub Registry & Image Tag
DOCKER_REGISTRY=tinashemp
TAG=latest

# Performance & Auto-Initialization
AUTO_SEED=True
GUNICORN_WORKERS=0
